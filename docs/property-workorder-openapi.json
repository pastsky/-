    "/api/work-orders": {
      "post": {
        "tags": ["work-orders"],
        "summary": "创建报修工单",
        "description": "权限：RESIDENT",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/WorkOrderCreateRequest" },
              "example": {
                "title": "3栋2单元水管漏水",
                "description": "厨房水管接口处漏水严重",
                "type": "WATER",
                "priority": "HIGH",
                "images": ["https://xxx/a.jpg", "https://xxx/b.jpg"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "example": 0 },
                    "message": { "type": "string", "example": "success" },
                    "data": { "$ref": "#/components/schemas/WorkOrderBrief" }
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": ["work-orders"],
        "summary": "工单列表（分页+筛选）",
        "description": "权限：登录用户",
        "parameters": [
          { "$ref": "#/components/parameters/PageParam" },
          { "$ref": "#/components/parameters/PageSizeParam" },
          { "name": "status", "in": "query", "required": false, "schema": { "$ref": "#/components/schemas/WorkOrderStatus" }, "description": "工单状态" },
          { "name": "type", "in": "query", "required": false, "schema": { "$ref": "#/components/schemas/WorkOrderType" }, "description": "报修类型" },
          { "name": "priority", "in": "query", "required": false, "schema": { "$ref": "#/components/schemas/WorkOrderPriority" }, "description": "优先级" },
          { "$ref": "#/components/parameters/KeywordParam" },
          { "name": "startDate", "in": "query", "required": false, "schema": { "type": "string", "format": "date" }, "description": "开始日期" },
          { "name": "endDate", "in": "query", "required": false, "schema": { "type": "string", "format": "date" }, "description": "结束日期" },
          { "name": "assigneeId", "in": "query", "required": false, "schema": { "type": "integer", "format": "int64" }, "description": "处理人ID" },
          { "name": "reporterId", "in": "query", "required": false, "schema": { "type": "integer", "format": "int64" }, "description": "报修人ID" }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "example": 0 },
                    "message": { "type": "string", "example": "success" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "list": { "type": "array", "items": { "$ref": "#/components/schemas/WorkOrderListItem" } },
                        "total": { "type": "integer", "example": 100 },
                        "page": { "type": "integer", "example": 1 },
                        "pageSize": { "type": "integer", "example": 20 }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
