    "title": "物业公司运维工单管理平台 API",
    "version": "1.0.0",
    "description": "物业公司运维工单管理平台前后端分离接口规范。\n统一响应结构：{ code, message, data }，code=0 表示成功。\n统一认证：Authorization: Bearer <JWT>。\nJSON 字段统一使用 camelCase（小驼峰）。"
  },
  "servers": [
    { "url": "http://localhost:8080", "description": "开发环境" }
  ],
  "tags": [
    { "name": "auth", "description": "认证模块" },
    { "name": "users", "description": "用户模块" },
    { "name": "work-orders", "description": "工单模块" },
    { "name": "stats", "description": "统计报表模块" }
  ],
