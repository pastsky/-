          "200": {
            "description": "文件流",
            "content": {
              "application/octet-stream": {
                "schema": { "type": "string", "format": "binary" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "登录后获取的 JWT，请求头：Authorization: Bearer <token>"
      }
    },
    "parameters": {
      "IdParam": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "integer", "format": "int64" },
        "description": "主键ID"
      },
      "PageParam": {
        "name": "page",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "default": 1 },
        "description": "页码，从 1 开始"
      },
      "PageSizeParam": {
        "name": "pageSize",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "default": 20 },
        "description": "每页条数"
      },
      "KeywordParam": {
        "name": "keyword",
        "in": "query",
        "required": false,
        "schema": { "type": "string" },
        "description": "关键字（模糊搜索）"
      }
    },
    "schemas": {
      "Role": {
        "type": "string",
        "enum": ["RESIDENT", "CUSTOMER_SERVICE", "ENGINEER", "ADMIN"],
        "description": "角色编码"
      },
      "UserStatus": {
        "type": "string",
        "enum": ["ACTIVE", "DISABLED"],
        "description": "用户状态"
      },
      "WorkOrderStatus": {
        "type": "string",
        "enum": ["PENDING", "ASSIGNED", "PROCESSING", "COMPLETED", "CLOSED", "CANCELED"],
        "description": "工单状态"
      },
      "WorkOrderPriority": {
        "type": "string",
        "enum": ["LOW", "MEDIUM", "HIGH", "URGENT"],
        "description": "工单优先级"
      },
      "WorkOrderType": {
        "type": "string",
        "enum": ["WATER", "ELECTRIC", "AIR", "LIFT", "FIRE", "CLEANING", "SECURITY", "OTHER"],
        "description": "报修类型"
      },
      "WorkOrderAction": {
        "type": "string",
        "enum": ["CREATE", "ASSIGN", "ACCEPT", "COMPLETE", "CLOSE", "CANCEL", "RATE"],
        "description": "工单动作编码"
      },
      "LoginRequest": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string", "description": "登录名" },
          "password": { "type": "string", "description": "密码" }
        }
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "username": { "type": "string" },
          "realName": { "type": "string" },
          "role": { "$ref": "#/components/schemas/Role" }
        }
      },
      "LoginData": {
        "type": "object",
        "properties": {
          "token": { "type": "string", "description": "JWT Token" },
          "user": { "$ref": "#/components/schemas/UserInfo" }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "username": { "type": "string" },
          "realName": { "type": "string" },
          "phone": { "type": "string", "nullable": true },
          "email": { "type": "string", "nullable": true },
          "role": { "$ref": "#/components/schemas/Role" },
          "status": { "$ref": "#/components/schemas/UserStatus" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "UserBrief": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "realName": { "type": "string" },
          "phone": { "type": "string", "nullable": true }
        }
      },
      "UserCreateRequest": {
        "type": "object",
        "required": ["username", "password", "realName", "role"],
        "properties": {
          "username": { "type": "string" },
          "password": { "type": "string" },
          "realName": { "type": "string" },
          "phone": { "type": "string" },
          "email": { "type": "string" },
          "role": { "$ref": "#/components/schemas/Role" },
          "status": { "$ref": "#/components/schemas/UserStatus" }
        }
      },
      "UserUpdateRequest": {
        "type": "object",
        "properties": {
          "realName": { "type": "string" },
          "phone": { "type": "string" },
          "email": { "type": "string" },
          "role": { "$ref": "#/components/schemas/Role" },
          "status": { "$ref": "#/components/schemas/UserStatus" }
        }
      },
      "PasswordResetRequest": {
        "type": "object",
        "required": ["newPassword"],
        "properties": {
          "newPassword": { "type": "string", "description": "新密码" }
        }
      },
      "WorkOrderCreateRequest": {
        "type": "object",
        "required": ["title", "type"],
        "properties": {
          "title": { "type": "string", "description": "工单标题" },
          "description": { "type": "string", "description": "问题描述" },
          "type": { "$ref": "#/components/schemas/WorkOrderType" },
          "priority": { "$ref": "#/components/schemas/WorkOrderPriority" },
          "images": { "type": "array", "items": { "type": "string" }, "description": "附件图片URL数组" }
        }
      },
      "WorkOrderUpdateRequest": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string" },
          "type": { "$ref": "#/components/schemas/WorkOrderType" },
          "priority": { "$ref": "#/components/schemas/WorkOrderPriority" },
          "images": { "type": "array", "items": { "type": "string" } }
        }
      },
      "AssignRequest": {
        "type": "object",
        "required": ["assigneeId"],
        "properties": {
          "assigneeId": { "type": "integer", "format": "int64", "description": "维修工用户ID" },
          "remark": { "type": "string", "description": "备注" }
        }
      },
      "RemarkRequest": {
        "type": "object",
        "properties": {
          "remark": { "type": "string", "description": "备注说明" }
        }
      },
      "RateRequest": {
        "type": "object",
        "required": ["rating"],
        "properties": {
          "rating": { "type": "integer", "minimum": 1, "maximum": 5, "description": "评价星级（1-5）" },
          "comment": { "type": "string", "description": "评价内容" }
        }
      },
      "WorkOrderListItem": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "orderNo": { "type": "string" },
          "title": { "type": "string" },
          "type": { "$ref": "#/components/schemas/WorkOrderType" },
          "priority": { "$ref": "#/components/schemas/WorkOrderPriority" },
          "status": { "$ref": "#/components/schemas/WorkOrderStatus" },
          "reporterName": { "type": "string" },
          "assigneeName": { "type": "string", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "WorkOrderDetail": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "orderNo": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "type": { "$ref": "#/components/schemas/WorkOrderType" },
          "priority": { "$ref": "#/components/schemas/WorkOrderPriority" },
          "status": { "$ref": "#/components/schemas/WorkOrderStatus" },
          "images": { "type": "array", "items": { "type": "string" } },
          "reporter": { "$ref": "#/components/schemas/UserBrief" },
          "assignee": { "$ref": "#/components/schemas/UserBrief" },
          "assignTime": { "type": "string", "format": "date-time", "nullable": true },
          "acceptTime": { "type": "string", "format": "date-time", "nullable": true },
          "finishTime": { "type": "string", "format": "date-time", "nullable": true },
          "closeTime": { "type": "string", "format": "date-time", "nullable": true },
          "rating": { "type": "integer", "description": "评价星级（0表示未评价）" },
          "ratingComment": { "type": "string", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "WorkOrderBrief": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "orderNo": { "type": "string" },
          "status": { "$ref": "#/components/schemas/WorkOrderStatus" }
        }
      },
      "WorkOrderLog": {
        "type": "object",
        "properties": {
          "action": { "$ref": "#/components/schemas/WorkOrderAction" },
          "operatorName": { "type": "string" },
          "fromStatus": { "$ref": "#/components/schemas/WorkOrderStatus" },
          "toStatus": { "$ref": "#/components/schemas/WorkOrderStatus" },
          "remark": { "type": "string", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "StatsOverview": {
        "type": "object",
        "properties": {
          "total": { "type": "integer", "description": "工单总数" },
          "pending": { "type": "integer", "description": "待派单" },
          "processing": { "type": "integer", "description": "处理中" },
          "completed": { "type": "integer", "description": "已完成" },
          "closed": { "type": "integer", "description": "已关闭" },
          "avgHandleHours": { "type": "number", "format": "double", "description": "平均处理时长（小时）" },
          "avgRating": { "type": "number", "format": "double", "description": "平均满意度" }
        }
      },
      "StatsTrendItem": {
        "type": "object",
        "properties": {
          "date": { "type": "string", "description": "统计日期/周期" },
          "count": { "type": "integer", "description": "工单数量" }
        }
      },
      "TypeDistributionItem": {
        "type": "object",
        "properties": {
          "type": { "$ref": "#/components/schemas/WorkOrderType" },
          "count": { "type": "integer" }
        }
      },
      "EngineerPerformanceItem": {
        "type": "object",
        "properties": {
          "engineerId": { "type": "integer", "format": "int64" },
          "engineerName": { "type": "string" },
          "totalOrders": { "type": "integer" },
          "avgHandleHours": { "type": "number", "format": "double" },
          "avgRating": { "type": "number", "format": "double" }
        }
      }
    }
  },
  "security": [
    { "bearerAuth": [] }
  ]
}
